{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concurso do catálogo Flora",
  "description": "Um arquivo por concurso em concursos/<id>.json. Os dados vêm do edital vigente.",
  "type": "object",
  "required": ["id", "titulo", "orgao", "cargo", "data_prova", "validacao", "fontes", "disciplinas"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "orgao-ano-cargo, igual ao nome do arquivo" },
    "titulo": { "type": "string", "minLength": 1 },
    "orgao": { "type": "string", "minLength": 1 },
    "cargo": { "type": "string", "minLength": 1 },
    "banca": { "type": "string" },
    "data_prova": { "type": "string", "format": "date" },
    "validacao": { "enum": ["pendente", "conferida"], "description": "conferida só depois de comparar com o edital e as retificações" },
    "verificado_em": { "type": "string", "format": "date" },
    "fontes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["titulo", "categoria", "url"],
        "properties": {
          "titulo": { "type": "string" },
          "categoria": { "type": "string", "examples": ["edital", "retificacao", "portal", "prova", "gabarito"] },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "disciplinas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nome", "questoes", "topicos"],
        "properties": {
          "nome": { "type": "string", "minLength": 1 },
          "questoes": { "type": "integer", "minimum": 1 },
          "topicos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
